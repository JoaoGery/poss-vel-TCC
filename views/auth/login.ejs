<%- include('../partials/header', { title: 'Entrar | AssistTech' }) %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="page-heading text-center">
        <div class="page-eyebrow">Acesso</div>
        <h1 class="page-title">Entrar no sistema</h1>
        <p class="page-subtitle mx-auto">Use seu cadastro para acessar o painel administrativo.</p>
      </div>

      <div class="content-card form-card">
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/auth/login" method="POST" class="vstack gap-3">
          <div>
            <label class="form-label" for="email">E-mail</label>
            <input class="form-control" type="email" id="email" name="email" autocomplete="email" required>
          </div>

          <div>
            <label class="form-label" for="senha">Senha</label>
            <input class="form-control" type="password" id="senha" name="senha" autocomplete="current-password" required>
          </div>

          <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
            <a class="btn btn-outline-secondary" href="/auth/register">Criar conta</a>
            <button class="btn btn-primary" type="submit">Entrar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
