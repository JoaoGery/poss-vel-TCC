<%- include('../partials/header', { title: 'Entrar | AssistTech' }) %>

<div class="container auth-page">
  <div class="auth-card">
    <section class="auth-intro">
      <div class="auth-intro-mark" aria-hidden="true">A</div>
      <div class="page-eyebrow">Gestão inteligente</div>
      <h1>Assistência técnica organizada, do atendimento à entrega.</h1>
      <p>Acesse o painel para acompanhar clientes, ordens de serviço e componentes em um único lugar.</p>
      <div class="auth-security-note"><span aria-hidden="true">✓</span> Ambiente de acesso restrito</div>
    </section>

    <section class="auth-form-area" aria-labelledby="login-title">
      <div class="page-heading">
        <div class="page-eyebrow">Acesso ao sistema</div>
        <h2 class="page-title" id="login-title">Boas-vindas</h2>
        <p class="page-subtitle">Entre com suas credenciais para continuar.</p>
      </div>

      <div class="auth-form">
        <%- include('../partials/flash') %>
        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>

        <form action="/auth/login" method="POST" class="vstack gap-3">
          <div>
            <label class="form-label" for="email">E-mail</label>
            <input class="form-control" type="email" id="email" name="email" autocomplete="email" required>
          </div>

          <div>
            <label class="form-label" for="senha">Senha</label>
            <input class="form-control" type="password" id="senha" name="senha" autocomplete="current-password" required>
          </div>

          <button class="btn btn-primary w-100" type="submit">Entrar no painel</button>
          <p class="auth-switch mb-0">Ainda não possui acesso? <a href="/auth/register">Criar conta</a></p>
        </form>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
