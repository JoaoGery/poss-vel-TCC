<%- include('../partials/header', { title: 'Clientes | AssistTech' }) %>

<div class="container">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 page-heading">
    <div>
      <div class="page-eyebrow">Cadastro</div>
      <h1 class="page-title">Clientes</h1>
      <p class="page-subtitle">Consulte, cadastre e mantenha os dados dos clientes atendidos.</p>
    </div>
    <div class="d-flex gap-2 align-items-start page-actions">
      <a href="/cliente/novo" class="btn btn-primary">Novo cliente</a>
    </div>
  </div>

  <form class="content-card filter-card mb-3" method="get" action="/cliente">
    <div class="row g-3 align-items-end">
      <div class="col-md-9">
        <label class="form-label" for="q">Pesquisar</label>
        <input id="q" type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" class="form-control" placeholder="Nome, e-mail ou telefone">
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-outline-primary flex-fill" type="submit">Filtrar</button>
        <a href="/cliente" class="btn btn-outline-secondary">Limpar</a>
      </div>
    </div>
  </form>

  <section class="content-card">
    <% if (!clientes || clientes.length === 0) { %>
      <div class="empty-state">Nenhum cliente encontrado.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Telefone</th>
              <th>Cidade</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% clientes.forEach(function(c, i) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><strong><%= c.nome || '-' %></strong></td>
                <td><%= c.email || '-' %></td>
                <td><%= c.telefone || '-' %></td>
                <td><%= [c.cidade, c.estado].filter(Boolean).join(' / ') || '-' %></td>
                <td class="text-end">
                  <a href="/cliente/<%= c._id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
                  <form action="/cliente/<%= c._id %>/deletar" method="post" class="d-inline" onsubmit="return confirm('Confirma a exclusão deste cliente?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
