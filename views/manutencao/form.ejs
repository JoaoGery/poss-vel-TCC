<%- include('../partials/header', { title: (manutencao._id ? 'Editar manutenção' : 'Nova manutenção') + ' | AssistTech' }) %>

<div class="container">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 page-heading">
    <div>
      <div class="page-eyebrow">Ordem de serviço</div>
      <h1 class="page-title"><%= manutencao._id ? 'Editar manutenção' : 'Nova manutenção' %></h1>
      <p class="page-subtitle">Registre o equipamento, problema relatado, diagnóstico e componentes envolvidos.</p>
    </div>
    <div class="d-flex gap-2 align-items-start page-actions">
      <a href="/manutencoes" class="btn btn-outline-secondary">Voltar</a>
    </div>
  </div>

  <div class="content-card form-card">
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form method="POST" action="<%= manutencao._id ? '/manutencoes/' + manutencao._id + '/atualizar' : '/manutencoes' %>" class="row g-3">
      <div class="col-md-6">
        <label class="form-label" for="cliente">Cliente</label>
        <select id="cliente" class="form-select" name="cliente" required>
          <option value="">Selecione um cliente</option>
          <% clientes.forEach(function(cliente){ %>
            <option value="<%= cliente._id %>" <%= String(manutencao.cliente) === String(cliente._id) ? 'selected' : '' %>><%= cliente.nome %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="marcaComputador">Marca</label>
        <input id="marcaComputador" type="text" class="form-control" name="marcaComputador" value="<%= manutencao.marcaComputador || '' %>" required>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="modeloComputador">Modelo</label>
        <input id="modeloComputador" type="text" class="form-control" name="modeloComputador" value="<%= manutencao.modeloComputador || '' %>" required>
      </div>

      <div class="col-12">
        <label class="form-label" for="descricaoProblema">Descrição do problema</label>
        <textarea id="descricaoProblema" class="form-control" rows="4" name="descricaoProblema" required><%= manutencao.descricaoProblema || '' %></textarea>
      </div>

      <% if (manutencao._id) { %>
        <div class="col-md-6">
          <label class="form-label" for="status">Status</label>
          <select id="status" class="form-select" name="status">
            <option value="em_analise" <%= manutencao.status === 'em_analise' ? 'selected' : '' %>>Em análise</option>
            <option value="em_reparo" <%= manutencao.status === 'em_reparo' ? 'selected' : '' %>>Em reparo</option>
            <option value="concluido" <%= manutencao.status === 'concluido' ? 'selected' : '' %>>Concluído</option>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label" for="valorTotal">Valor total (R$)</label>
          <input id="valorTotal" type="number" step="0.01" min="0" class="form-control" name="valorTotal" value="<%= manutencao.valorTotal || 0 %>">
        </div>

        <div class="col-12">
          <label class="form-label" for="diagnosticoTecnico">Diagnóstico técnico</label>
          <textarea id="diagnosticoTecnico" class="form-control" rows="4" name="diagnosticoTecnico"><%= manutencao.diagnosticoTecnico || '' %></textarea>
        </div>

        <div class="col-12">
          <label class="form-label" for="componentes">Componentes utilizados</label>
          <% const selecionados = (manutencao.componentes || []).map(function(id) { return String(id._id || id); }); %>
          <select id="componentes" class="form-select" name="componentes" multiple size="5">
            <% componentes.forEach(function(componente){ %>
              <% const selecionado = selecionados.includes(String(componente._id)); %>
              <% const semEstoque = Number(componente.quantidadeDisponivel || 0) <= 0; %>
              <option value="<%= componente._id %>" <%= selecionado ? 'selected' : '' %> <%= semEstoque && !selecionado ? 'disabled' : '' %>>
                <%= componente.nome %> - <%= componente.categoria %> (estoque: <%= componente.quantidadeDisponivel %><%= semEstoque && !selecionado ? ' - indisponível' : '' %>)
              </option>
            <% }) %>
          </select>
          <div class="form-text">Use Ctrl ou Cmd para selecionar mais de um item.</div>
        </div>

        <div class="col-12">
          <label class="form-label" for="observacoes">Observações</label>
          <textarea id="observacoes" class="form-control" rows="3" name="observacoes"><%= manutencao.observacoes || '' %></textarea>
        </div>
      <% } %>

      <div class="col-12 d-flex justify-content-end gap-2">
        <a href="/manutencoes" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
