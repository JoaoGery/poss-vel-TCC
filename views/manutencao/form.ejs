<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>
        <%= Object.keys(manutencao).length> 0 ? 'Editar' : 'Nova' %> Manutenção
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container py-4">
        <h1 class="h3 mb-4">
            <%= Object.keys(manutencao).length> 0 ? 'Editar' : 'Nova' %> Manutenção
        </h1>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>

                <div class="row">
                    <div class="col-lg-8">
                        <form method="post"
                            action="<%= Object.keys(manutencao).length > 0 ? '/manutencoes/' + manutencao._id + '/atualizar' : '/manutencoes' %>">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Informações da Manutenção</h5>
                                </div>
                                <div class="card-body">

                                    <% if (Object.keys(manutencao).length===0) { %>
                                        <!-- Criação -->
                                        <div class="mb-3">
                                            <label class="form-label">Computador *</label>
                                            <select class="form-select" name="computador" required>
                                                <option value="">Selecione um computador...</option>
                                                <% computadores.forEach(function(comp) { %>
                                                    <option value="<%= comp._id %>">
                                                        <%= comp.modelo %> - <%= comp.serial %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Cliente *</label>
                                            <select class="form-select" name="cliente" required>
                                                <option value="">Selecione um cliente...</option>
                                                <% clientes.forEach(function(cli) { %>
                                                    <option value="<%= cli._id %>">
                                                        <%= cli.nome %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Problema Solicitado *</label>
                                            <textarea class="form-control" name="problemaSolicitado" rows="3"
                                                required></textarea>
                                        </div>
                                        <% } else { %>
                                            <!-- Edição -->
                                            <div class="row mb-3">
                                                <div class="col-md-6">
                                                    <h6 class="text-muted">Computador</h6>
                                                    <p>
                                                        <%= manutencao.computador.modelo %> - <%=
                                                                manutencao.computador.serial %>
                                                    </p>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6 class="text-muted">Cliente</h6>
                                                    <p>
                                                        <%= manutencao.cliente.nome %>
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Problema Solicitado</label>
                                                <textarea class="form-control" name="problemaSolicitado"
                                                    rows="2"><%= manutencao.problemaSolicitado %></textarea>
                                            </div>

                                            <hr>

                                            <div class="mb-3">
                                                <label class="form-label">Status</label>
                                                <select class="form-select" name="status">
                                                    <option value="pendente" <%=manutencao.status==='pendente'
                                                        ? 'selected' : '' %>>Pendente</option>
                                                    <option value="em_andamento" <%=manutencao.status==='em_andamento'
                                                        ? 'selected' : '' %>>Em Andamento</option>
                                                    <option value="finalizado" <%=manutencao.status==='finalizado'
                                                        ? 'selected' : '' %>>Finalizado</option>
                                                    <option value="cancelado" <%=manutencao.status==='cancelado'
                                                        ? 'selected' : '' %>>Cancelado</option>
                                                </select>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Data Início</label>
                                                    <input type="datetime-local" class="form-control" name="dataInicio"
                                                        value="<%= manutencao.dataInicio ? new Date(manutencao.dataInicio).toISOString().slice(0, 16) : '' %>">
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Data Finalização</label>
                                                    <input type="datetime-local" class="form-control"
                                                        name="dataFinalizacao"
                                                        value="<%= manutencao.dataFinalizacao ? new Date(manutencao.dataFinalizacao).toISOString().slice(0, 16) : '' %>">
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Diagnóstico</label>
                                                <textarea class="form-control" name="diagnostico"
                                                    rows="3"><%= manutencao.diagnostico || '' %></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Serviços Realizados</label>
                                                <textarea class="form-control" name="servicosRealizados"
                                                    rows="3"><%= manutencao.servicosRealizados || '' %></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Peças Trocadas</label>
                                                <textarea class="form-control" name="pecasTrocadas"
                                                    rows="3"><%= manutencao.pecasTrocadas || '' %></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Valor Total (R$)</label>
                                                <input type="number" class="form-control" name="valorTotal" step="0.01"
                                                    value="<%= manutencao.valorTotal || 0 %>">
                                            </div>
                                            <% } %>

                                </div>
                                <div class="card-footer d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">Salvar</button>
                                    <a href="/manutencoes" class="btn btn-secondary">Cancelar</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>