<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= manutencao._id ? 'Editar Manutenção' : 'Nova Manutenção' %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background:#f4f7fb;
        }

        .card{
            border:none;
            border-radius:16px;
            box-shadow:0 10px 25px rgba(0,0,0,.05);
        }
    </style>
</head>

<body>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <%= manutencao._id ? 'Editar Manutenção' : 'Nova Manutenção' %>
        </h1>

        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-primary">
                Dashboard
            </a>

            <a href="/manutencoes" class="btn btn-secondary">
                Voltar para Manutenções
            </a>
        </div>
    </div>

    <% if(typeof error !== 'undefined' && error){ %>
        <div class="alert alert-danger">
            <%= error %>
        </div>
    <% } %>

    <div class="row">
        <div class="col-lg-8">

            <form
                method="POST"
                action="<%= manutencao._id ? '/manutencoes/' + manutencao._id + '/atualizar' : '/manutencoes' %>">

                <div class="card">

                    <div class="card-header bg-primary text-white">
                        Dados da Manutenção
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <label class="form-label">
                                Cliente
                            </label>

                            <select
                                class="form-select"
                                name="cliente"
                                required>

                                <option value="">
                                    Selecione um cliente
                                </option>

                                <% clientes.forEach(function(cliente){ %>

                                    <option
                                        value="<%= cliente._id %>"
                                        <%= String(manutencao.cliente) === String(cliente._id) ? 'selected' : '' %>>
                                        <%= cliente.nome %>
                                    </option>

                                <% }) %>

                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Marca do Computador
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="marcaComputador"
                                value="<%= manutencao.marcaComputador || '' %>"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Modelo do Computador
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="modeloComputador"
                                value="<%= manutencao.modeloComputador || '' %>"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Descrição do Problema
                            </label>

                            <textarea
                                class="form-control"
                                rows="4"
                                name="descricaoProblema"
                                required><%= manutencao.descricaoProblema || '' %></textarea>
                        </div>

                        <% if(manutencao._id){ %>

                        <hr>

                        <div class="mb-3">
                            <label class="form-label">
                                Diagnóstico Técnico
                            </label>

                            <textarea
                                class="form-control"
                                rows="4"
                                name="diagnosticoTecnico"><%= manutencao.diagnosticoTecnico || '' %></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Status
                            </label>

                            <select
                                class="form-select"
                                name="status">

                                <option value="em_analise"
                                    <%= manutencao.status === 'em_analise' ? 'selected' : '' %>>
                                    Em Análise
                                </option>

                                <option value="em_reparo"
                                    <%= manutencao.status === 'em_reparo' ? 'selected' : '' %>>
                                    Em Reparo
                                </option>

                                <option value="concluido"
                                    <%= manutencao.status === 'concluido' ? 'selected' : '' %>>
                                    Concluído
                                </option>

                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Valor Total (R$)
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                class="form-control"
                                name="valorTotal"
                                value="<%= manutencao.valorTotal || '' %>">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Observações
                            </label>

                            <textarea
                                class="form-control"
                                rows="3"
                                name="observacoes"><%= manutencao.observacoes || '' %></textarea>
                        </div>

                        <% } %>

                    </div>

                    <div class="card-footer d-flex gap-2">

                        <button
                            type="submit"
                            class="btn btn-primary">
                            Salvar
                        </button>

                        <a
                            href="/"
                            class="btn btn-outline-primary">
                            Dashboard
                        </a>

                        <a
                            href="/manutencoes"
                            class="btn btn-secondary">
                            Cancelar
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
