<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'AssistTech' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg app-navbar">
    <div class="container">
      <a class="navbar-brand" href="/">AssistTech</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/cliente">Clientes</a></li>
          <li class="nav-item"><a class="nav-link" href="/manutencoes">Manutenções</a></li>
          <li class="nav-item"><a class="nav-link" href="/componentes">Componentes</a></li>
          <% if (currentUser) { %>
            <li class="nav-item ms-lg-3 text-secondary small">Olá, <%= currentUser %></li>
            <li class="nav-item ms-lg-2">
              <form action="/auth/logout" method="post">
                <button class="btn btn-sm btn-outline-secondary" type="submit">Sair</button>
              </form>
            </li>
          <% } else { %>
            <li class="nav-item ms-lg-3"><a class="btn btn-sm btn-primary" href="/auth/login">Entrar</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <main class="app-shell">
