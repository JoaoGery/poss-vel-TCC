<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Componentes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">Componentes em Estoque</h1>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-outline-primary">Dashboard</a>
                <a href="/componentes/novo" class="btn btn-primary">Adicionar Componente</a>
            </div>
        </div>

        <form class="card mb-3" method="get" action="/componentes">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Pesquisar</label>
                        <input
                            type="search"
                            name="q"
                            class="form-control"
                            value="<%= typeof q !== 'undefined' ? q : '' %>"
                            placeholder="Nome, fornecedor ou descrição">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Categoria</label>
                        <select class="form-select" name="categoria">
                            <option value="">Todas</option>
                            <% ['Processador', 'RAM', 'SSD', 'HDD', 'Fonte', 'Placa-Mãe', 'Cooler', 'Placa de Vídeo', 'Outro'].forEach(function(cat) { %>
                                <option value="<%= cat %>" <%= categoria === cat ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
                    </div>
                </div>
            </div>
        </form>

        <% if (typeof success !=='undefined' && success) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
            <% } %>
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                    <% } %>

                        <% if (!componentes || componentes.length===0) { %>
                            <div class="card">
                                <div class="card-body text-center">
                                    Nenhum componente cadastrado.
                                </div>
                            </div>
                            <% } else { %>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Nome</th>
                                                <th>Categoria</th>
                                                <th>Quantidade</th>
                                                <th>Preço Unit.</th>
                                                <th>Fornecedor</th>
                                                <th class="text-end">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% componentes.forEach(function(componente, i) { %>
                                                <tr>
                                                    <td>
                                                        <%= i + 1 %>
                                                    </td>
                                                    <td><strong>
                                                            <%= componente.nome %>
                                                        </strong></td>
                                                    <td><span class="badge bg-info">
                                                            <%= componente.categoria %>
                                                        </span></td>
                                                    <td>
                                                        <% if (componente.quantidadeDisponivel> 5) { %>
                                                            <span class="badge bg-success">
                                                                <%= componente.quantidadeDisponivel %>
                                                            </span>
                                                            <% } else if (componente.quantidadeDisponivel> 0) { %>
                                                                <span class="badge bg-warning">
                                                                    <%= componente.quantidadeDisponivel %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span class="badge bg-danger">0</span>
                                                                    <% } %>
                                                    </td>
                                                    <td>R$ <%= Number(componente.precoUnitario || 0).toFixed(2) %>
                                                    </td>
                                                    <td><small>
                                                            <%= componente.fornecedor || '-' %>
                                                        </small></td>
                                                    <td class="text-end">
                                                        <a href="/componentes/<%= componente._id %>"
                                                            class="btn btn-sm btn-outline-info me-1">Ver</a>
                                                        <a href="/componentes/<%= componente._id %>/editar"
                                                            class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                                                        <form action="/componentes/<%= componente._id %>/deletar"
                                                            method="post" class="d-inline"
                                                            onsubmit="return confirm('Tem certeza?')">
                                                            <button type="submit"
                                                                class="btn btn-sm btn-outline-danger">Excluir</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                                <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
