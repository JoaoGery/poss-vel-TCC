<%- include('../partials/header', { title: 'Componentes | AssistTech' }) %>

<div class="container">
  <%- include('../partials/flash') %>
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 page-heading">
    <div>
      <div class="page-eyebrow">Estoque</div>
      <h1 class="page-title">Componentes</h1>
      <p class="page-subtitle">Controle peças disponíveis, fornecedores e valores usados nos reparos.</p>
    </div>
    <div class="d-flex gap-2 align-items-start page-actions">
      <a href="/componentes/novo" class="btn btn-primary">Adicionar componente</a>
    </div>
  </div>

  <form class="content-card filter-card mb-3" method="get" action="/componentes">
    <div class="row g-3 align-items-end">
      <div class="col-md-6">
        <label class="form-label" for="q">Pesquisar</label>
        <input id="q" type="search" name="q" class="form-control" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Nome, fornecedor ou descrição">
      </div>
      <div class="col-md-4">
        <label class="form-label" for="categoria">Categoria</label>
        <select id="categoria" class="form-select" name="categoria">
          <option value="">Todas</option>
          <% ['Processador', 'RAM', 'SSD', 'HDD', 'Fonte', 'Placa-Mãe', 'Cooler', 'Placa de Vídeo', 'Outro'].forEach(function(cat) { %>
            <option value="<%= cat %>" <%= categoria === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-fill">Filtrar</button>
      </div>
    </div>
  </form>

  <section class="content-card">
    <% if (!componentes || componentes.length === 0) { %>
      <div class="empty-state">Nenhum componente cadastrado.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>Nome</th>
              <th>Categoria</th>
              <th>Estoque</th>
              <th>Preço unit.</th>
              <th>Fornecedor</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% componentes.forEach(function(componente, i) { %>
              <% const stockClass = componente.quantidadeDisponivel > 5 ? 'stock-ok' : componente.quantidadeDisponivel > 0 ? 'stock-low' : 'stock-out'; %>
              <tr>
                <td><%= i + 1 %></td>
                <td><strong><%= componente.nome %></strong></td>
                <td><%= componente.categoria %></td>
                <td><span class="status-badge <%= stockClass %>"><%= componente.quantidadeDisponivel %></span></td>
                <td>R$ <%= Number(componente.precoUnitario || 0).toFixed(2) %></td>
                <td><%= componente.fornecedor || '-' %></td>
                <td class="text-end">
                  <a href="/componentes/<%= componente._id %>" class="btn btn-sm btn-outline-primary">Ver</a>
                  <a href="/componentes/<%= componente._id %>/editar" class="btn btn-sm btn-outline-secondary">Editar</a>
                  <form action="/componentes/<%= componente._id %>/deletar" method="post" class="d-inline" onsubmit="return confirm('Deseja excluir este componente?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
