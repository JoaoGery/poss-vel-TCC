<%- include('../partials/header', { title: (componente._id ? 'Editar componente' : 'Adicionar componente') + ' | AssistTech' }) %>

<div class="container">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 page-heading">
    <div>
      <div class="page-eyebrow">Estoque</div>
      <h1 class="page-title"><%= componente._id ? 'Editar componente' : 'Adicionar componente' %></h1>
      <p class="page-subtitle">Mantenha o catálogo de peças pronto para ser usado nas ordens de serviço.</p>
    </div>
    <div class="d-flex gap-2 align-items-start page-actions">
      <a href="/componentes" class="btn btn-outline-secondary">Voltar</a>
    </div>
  </div>

  <div class="content-card form-card">
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form method="post" action="<%= componente._id ? '/componentes/' + componente._id + '/atualizar' : '/componentes' %>" class="row g-3">
      <div class="col-md-6">
        <label class="form-label" for="nome">Nome do componente</label>
        <input id="nome" type="text" class="form-control" name="nome" value="<%= componente.nome || '' %>" required>
      </div>

      <div class="col-md-6">
        <label class="form-label" for="categoria">Categoria</label>
        <select id="categoria" class="form-select" name="categoria" required>
          <option value="">Selecione...</option>
          <% ['Processador', 'RAM', 'SSD', 'HDD', 'Fonte', 'Placa-Mãe', 'Cooler', 'Placa de Vídeo', 'Outro'].forEach(function(cat) { %>
            <option value="<%= cat %>" <%= componente.categoria === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-6">
        <label class="form-label" for="quantidadeDisponivel">Quantidade disponível</label>
        <input id="quantidadeDisponivel" type="number" class="form-control" name="quantidadeDisponivel" value="<%= componente.quantidadeDisponivel || 0 %>" min="0" required>
      </div>

      <div class="col-md-6">
        <label class="form-label" for="precoUnitario">Preço unitário (R$)</label>
        <input id="precoUnitario" type="number" class="form-control" name="precoUnitario" value="<%= componente.precoUnitario || 0 %>" step="0.01" min="0" required>
      </div>

      <div class="col-12">
        <label class="form-label" for="fornecedor">Fornecedor</label>
        <input id="fornecedor" type="text" class="form-control" name="fornecedor" value="<%= componente.fornecedor || '' %>">
      </div>

      <div class="col-12">
        <label class="form-label" for="descricao">Descrição</label>
        <textarea id="descricao" class="form-control" name="descricao" rows="3"><%= componente.descricao || '' %></textarea>
      </div>

      <div class="col-12 d-flex justify-content-end gap-2">
        <a href="/componentes" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
