<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>
        <%= Object.keys(componente).length> 0 ? 'Editar' : 'Adicionar' %> Componente
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container py-4">
        <h1 class="h3 mb-4">
            <%= Object.keys(componente).length> 0 ? 'Editar' : 'Adicionar' %> Componente
        </h1>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>

                <div class="row">
                    <div class="col-lg-6">
                        <form method="post"
                            action="<%= Object.keys(componente).length > 0 ? '/componentes/' + componente._id + '/atualizar' : '/componentes' %>">
                            <div class="card">
                                <div class="card-body">

                                    <div class="mb-3">
                                        <label class="form-label">Nome do Componente *</label>
                                        <input type="text" class="form-control" name="nome"
                                            value="<%= componente.nome || '' %>" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Categoria *</label>
                                        <select class="form-select" name="categoria" required>
                                            <option value="">Selecione...</option>
                                            <option value="Processador" <%=componente.categoria==='Processador'
                                                ? 'selected' : '' %>>Processador</option>
                                            <option value="RAM" <%=componente.categoria==='RAM' ? 'selected' : '' %>>RAM
                                            </option>
                                            <option value="SSD" <%=componente.categoria==='SSD' ? 'selected' : '' %>>SSD
                                            </option>
                                            <option value="HDD" <%=componente.categoria==='HDD' ? 'selected' : '' %>>HDD
                                            </option>
                                            <option value="Fonte" <%=componente.categoria==='Fonte' ? 'selected' : '' %>
                                                >Fonte</option>
                                            <option value="Placa-Mãe" <%=componente.categoria==='Placa-Mãe' ? 'selected'
                                                : '' %>>Placa-Mãe</option>
                                            <option value="Cooler" <%=componente.categoria==='Cooler' ? 'selected' : ''
                                                %>>Cooler</option>
                                            <option value="Placa de Vídeo" <%=componente.categoria==='Placa de Vídeo'
                                                ? 'selected' : '' %>>Placa de Vídeo</option>
                                            <option value="Outro" <%=componente.categoria==='Outro' ? 'selected' : '' %>
                                                >Outro</option>
                                        </select>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Quantidade Disponível *</label>
                                            <input type="number" class="form-control" name="quantidadeDisponivel"
                                                value="<%= componente.quantidadeDisponivel || 0 %>" min="0" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Preço Unitário (R$) *</label>
                                            <input type="number" class="form-control" name="precoUnitario"
                                                value="<%= componente.precoUnitario || 0 %>" step="0.01" min="0"
                                                required>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Fornecedor</label>
                                        <input type="text" class="form-control" name="fornecedor"
                                            value="<%= componente.fornecedor || '' %>">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Descrição</label>
                                        <textarea class="form-control" name="descricao"
                                            rows="3"><%= componente.descricao || '' %></textarea>
                                    </div>

                                </div>
                                <div class="card-footer d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">Salvar</button>
                                    <a href="/componentes" class="btn btn-secondary">Cancelar</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>